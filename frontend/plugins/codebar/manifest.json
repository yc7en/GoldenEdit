{
  "id": "codebar",
  "name": "代码块工具条",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "builtin",
  "description": "为代码块提供语言徽标与一键复制按钮",
  "trust": "builtin",
  "entry": "entry.js",
  "style": "style.css",
  "match": {
    "fence": [
      "js",
      "javascript",
      "ts",
      "typescript",
      "json",
      "html",
      "css",
      "rust",
      "rs",
      "python",
      "py",
      "sh",
      "bash",
      "shell",
      "yaml",
      "yml",
      "sql",
      "xml",
      "markdown",
      "md",
      "c",
      "cpp",
      "go",
      "java"
    ],
    "container": [],
    "delimiter": []
  },
  "permissions": ["dom"],
  "config": {},
  "source": { "type": "builtin" }
}
